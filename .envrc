if command -v nix >/dev/null 2>&1; then
  use nix
fi
source_env .venv/bin/activate
# JS tools (oxlint, oxfmt, eslint, prettier, vite) at the versions yarn pinned.
# PATH_add prepends, so the last line wins: root tools shadow dashboard ones
# (both have tailwindcss; the root copy builds the Jinja CSS).
PATH_add dashboard/node_modules/.bin
PATH_add node_modules/.bin
