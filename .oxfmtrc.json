{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "printWidth": 99,
  "proseWrap": "never",
  "insertFinalNewline": true,
  "sortImports": {
    "internalPattern": [
      "@/"
    ]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "*.html",
    "fossunited/**/*.json",
    "fossunited/public/dashboard/**",
    "fossunited/public/dist/**",
    "fossunited/public/css/styles.css",
    "fossunited/dev/**",
    "frappe_docker/**",
    "development/**",
    "**/*.geojson"
  ],
  "overrides": [
    {
      "files": [
        "dashboard/**"
      ],
      "options": {
        "sortTailwindcss": {
          "config": "dashboard/tailwind.config.js"
        }
      }
    }
  ]
}
