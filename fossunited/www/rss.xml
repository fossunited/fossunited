{% extends "templates/rss.xml" %}
{# Atom feed of blog posts. Layout lives in templates/rss.xml. #}
{% block entry_extra scoped %}
{% if item.source_title %}
    <link rel="related" href="{{ item.id | e }}" type="text/html" title="Discuss on FOSS United" />
    <source>
      <id>{{ item.source_link | e }}</id>
      <title>{{ item.source_title | e }}</title>
      <link rel="alternate" href="{{ item.source_link | e }}" type="text/html" />
    </source>
{% endif %}
{% endblock %}
