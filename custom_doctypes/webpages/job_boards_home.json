  "dynamic_template": 0,
   "main_section_html": "{% set active_jobs = frappe.get_all('Job Board', filters={'status': 'Approved'}, fields=['name', 'job_title', 'job_location', 'company_name', 'company_website', 'job_type']) %}\n{% set expired_jobs = frappe.get_all('Job Board', filters={'status': 'Expired'}, fields=['name', 'job_title', 'job_location', 'company_name', 'company_website', 'job_type']) %}\n\n<div class=\"container\">\n  <div class=\"job-thumbnail mt-8\">\n    <img src=\"/files/job-board.png\" alt=\"job-thumbnail\" />\n  </div>\n\n  <div class=\"jobs-board pt-4 pb-8\">\n    <div class=\"d-flex justify-content-between align-items-center m-auto\">\n      <h4>Job Board</h4>\n      <a href=\"https://fossunited.org/post-a-job\" class=\"primary-button\">Post a Job</a>\n    </div>\n\n    <!-- Active Jobs -->\n    <div class=\"row job-listing pt-4\">\n      {% for job in active_jobs %}\n      <div class=\"col-lg-4 col-md-6 col-sm-1 card-deck\">\n        <div class=\"card my-2\">\n          <h5 class=\"card-title\">{{ job.job_title }}</h5>\n          <div class=\"card-body\">\n            <div class=\"d-flex flex-row detail\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\"\n                stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                class=\"icon icon-tabler icons-tabler-outline icon-tabler-buildings\">\n                <path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" />\n                <path d=\"M4 21v-15c0 -1 1 -2 2 -2h5c1 0 2 1 2 2v15\" />\n                <path d=\"M16 8h2c1 0 2 1 2 2v11\" />\n                <path d=\"M3 21h18\" />\n                <path d=\"M10 12v0\" />\n                <path d=\"M10 16v0\" />\n                <path d=\"M10 8v0\" />\n                <path d=\"M7 12v0\" />\n                <path d=\"M7 16v0\" />\n                <path d=\"M7 8v0\" />\n                <path d=\"M17 12v0\" />\n                <path d=\"M17 16v0\" />\n              </svg>\n              <h6><a href=\"{{ job.company_website }}\">{{ job.company_name }}</a></h6>\n            </div>\n            <div class=\"d-flex flex-row detail\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"icon icon-tabler icon-tabler-map-pin\"\n                viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"#000000\" fill=\"none\"\n                stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" />\n                <path d=\"M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\" />\n                <path\n                  d=\"M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z\" />\n              </svg>\n              <h6>{{ job.job_location }}</h6>\n            </div>\n          </div>\n          <div class=\"view-details\">\n            <div class=\"job-type\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\"\n                stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                class=\"icon icon-tabler icons-tabler-outline icon-tabler-briefcase-2\">\n                <path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" />\n                <path\n                  d=\"M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9z\" />\n                <path d=\"M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2\" />\n              </svg>\n              <h6>{{ job.job_type }}</h6>\n            </div>\n            <div class=\"job-view\">\n              <a href=\"/jobs/{{ job.name }}\">View Details</a>\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"\n                xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M6 4L10 8L6 12\" stroke=\"#08B74F\" stroke-width=\"2\" stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\" />\n              </svg>\n            </div>\n          </div>\n        </div>\n      </div>\n      {% endfor %}\n    </div>\n\n\t<!-- Toggle for expired jobs to show -->\n\t<details style=\"text-align: center;\">\n\t  <summary class=\"btn btn-outline-secondary\" style=\"list-style: none; cursor: pointer; display: inline-block;\">\n\t\t+ Show Expired Jobs\n\t  </summary>\n\n\n\t  <div class=\"mt-4\">\n\t\t<div class=\"row\">\n\t\t  {% for job in expired_jobs %}\n\t\t  <div class=\"col-lg-4 col-md-6 col-sm-1 card-deck\">\n\t\t\t<div class=\"card my-2 expired-job\">\n\t\t\t  <h5 class=\"card-title\">{{ job.job_title }}</h5>\n\t\t\t  <div class=\"card-body\">\n\t\t\t\t<div class=\"d-flex flex-row detail\">\n\t\t\t\t  <h6><a href=\"{{ job.company_website }}\">{{ job.company_name }}</a></h6>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"d-flex flex-row detail\">\n\t\t\t\t  <h6>{{ job.job_location }}</h6>\n\t\t\t\t</div>\n\t\t\t  </div>\n\t\t\t  <div class=\"view-details\">\n\t\t\t\t<div class=\"job-type\">\n\t\t\t\t  <h6>{{ job.job_type }}</h6>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"job-view\">\n\t\t\t\t  <a href=\"/jobs/{{ job.name }}\">View Details</a>\n\t\t\t\t</div>\n\t\t\t  </div>\n\t\t\t</div>\n\t\t  </div>\n\t\t  {% endfor %}\n\t\t</div>\n\t  </div>\n\t</details>\n\n\n  </div>\n</div>\n\n",

