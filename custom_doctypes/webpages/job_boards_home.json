  "css": ".job-listing {\n    gap: 5px !important;\n}\n.card {\n    border: 2px solid hsl(var(--clr-open-gray-100));\n    border-radius: 0.5rem;\n    line-height: 1.5rem;\n    flex-direction: column;\n    justify-content: space-between; \n    padding: 18px 20px;\n    gap: 22px;\n}\n.card-title {\n    font-size: 18px;\n}\n.card-body {\n    padding: 0%;\n}\n.card-body h6 {\n    font-size: 16px;\n    font-style: normal;\n    color: #667085;\n    line-height: 140%; /* 22.4px */\n    letter-spacing: -0.32px;\n}\nsvg {\n    margin: 0px !important;\n}\n.detail {\n    gap: 5px;\n}\n.view-details {\n    gap: 10px;\n    display: flex;\n    flex-direction: row;\n    justify-content: space-between;\n}\n.job-view {\n    display: flex;\n    flex-direction: row;\n    font-size: 14px;\n    padding: 8px 10px;\n    align-items: center;\n    align-self: center;\n    text-decoration: underline;\n    gap: 8px;\n    color: #08B74F;\n}\n.job-view svg {\n    width: 16px;\n    height: 16px; \n}\n.job-type {\n    display: flex;\n    flex-direction: row;\n    gap: 8px;\n    margin: 0px;\n    align-items: center;\n}\n.job-type h6 {\n    font-size: 14px;\n    font-style: normal; \n    color: #667085;\n}\n.job-type svg {\n    color: black !important;\n}\n\n@media screen and (max-width: 576px) {\n    .jobs-board h4 {\n        font-size: 24px;\n    }\n    .jobs-board a {\n        font-size: 18px;\n    }\n    .card-title {\n        font-size: 16px;\n    }\n}",
