meta {
  name: self-checkin-rejects-non-owner
  type: http
  seq: 2
}

post {
  url: {{base}}/method/fossunited.chapters.doctype.foss_event_rsvp_submission.foss_event_rsvp_submission.self_check_in
  body: json
  auth: none
}

docs {
  # self_check_in ownership check

  Tests that `self_check_in` rejects users who don't own the RSVP
  submission. Attacker (mock-attendee-1) tries to check in a submission
  belonging to mock-attendee-2.

  **Endpoint**: `fossunited.chapters.doctype.foss_event_rsvp_submission.foss_event_rsvp_submission.self_check_in`
  **Auth**: `@frappe.whitelist()` — needs ownership check
  **Seed data**: `rsvp_submission_other` env var → submission by attendee-2
  **Source**: `fossunited/chapters/doctype/foss_event_rsvp_submission/foss_event_rsvp_submission.py`
}

body:json {
  {
    "submission_name": "{{rsvp_submission_other}}"
  }
}

script:pre-request {
  const sid = bru.getVar("session_cookie_attacker");
  if (sid) {
    req.setHeader("Cookie", sid);
  }
}

tests {
  test("non-owner should be rejected from self check-in", function() {
    const status = res.getStatus();
    expect(status).to.be.oneOf([403, 417, 401]);
  });
}
