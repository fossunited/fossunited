meta {
  name: login-as-attacker
  type: http
  seq: 0
}

post {
  url: {{base}}/method/login
  body: json
  auth: none
}

docs {
  # Login as attacker (non-owner user)

  Authenticates as `mock-attendee-1` who does NOT own the RSVP
  submissions created by `mock-attendee-2`. This simulates an attacker
  trying to check in or modify another user's RSVP.

  **Seed data**: `attendee_email` / `attendee_password` env vars
  **Created by**: `development/seed.py` → `SEED_USERS`
}

body:json {
  {
    "usr": "{{attendee_email}}",
    "pwd": "{{attendee_password}}"
  }
}

tests {
  test("should login as non-owner user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("full_name");
  });
}

script:post-response {
  const cookies = res.getHeaders()['set-cookie'];
  if (cookies) {
    const sidCookie = cookies.find(c => c.startsWith('sid='));
    if (sidCookie) {
      bru.setVar("session_cookie_attacker", sidCookie.split(';')[0]);
    }
  }
}
