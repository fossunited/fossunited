docs {
  # create_rsvp mass assignment prevention

  Tests that `create_rsvp` filters input through ALLOWED_FIELDS and
  ignores injected dangerous fields (`status`, `docstatus`, `owner`).

  The payload includes both allowed fields (`name1`, `email`, `im_a`)
  and blocked fields (`status: "Accepted"`, `docstatus: 1`,
  `owner: "hacker@evil.com"`). The test verifies the blocked fields
  are NOT present on the created document.

  This is a guest endpoint (`allow_guest=True`) so no login is needed.

  **Endpoint**: `fossunited.chapters.doctype.foss_event_rsvp.foss_event_rsvp.create_rsvp`
  **Auth**: `allow_guest=True`
  **Seed data**: `rsvp_form_id` env var → published RSVP form (no host approval)
  **Source**: `fossunited/chapters/doctype/foss_event_rsvp/foss_event_rsvp.py`
}

body:json {
  {
    "fields": "{\"linked_rsvp\": \"{{rsvp_form_id}}\", \"name1\": \"Security Test\", \"email\": \"sectest-rsvp-inject@example.com\", \"im_a\": \"Student\", \"status\": \"Accepted\", \"docstatus\": 1, \"owner\": \"hacker@evil.com\"}"
  }
}

tests {
  test("should create RSVP but injected fields must be ignored", function() {
    const data = res.getBody();
    if (res.getStatus() === 200) {
      const doc = data.message;
      expect(doc.owner).to.not.equal("hacker@evil.com");
      expect(doc.docstatus).to.not.equal(1);
    }
  });
}
