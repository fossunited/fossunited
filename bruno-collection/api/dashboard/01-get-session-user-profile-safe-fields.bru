docs {
  # get_session_user_profile field exposure prevention

  Verifies that `get_session_user_profile` returns only whitelisted fields
  and not internal metadata (`password`, `_user_tags`, `docstatus`, etc.).

  Previously used `frappe.db.get_value(..., ["*"])` which leaked all columns.

  **Endpoint**: `fossunited.api.dashboard.get_session_user_profile`
  **Auth**: `@frappe.whitelist()` (logged-in users)
  **Seed data**: Uses the logged-in session user's own profile
  **Source**: `fossunited/api/dashboard.py`
}

tests {
  test("should return only safe profile fields", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
    const profile = data.message;
    expect(profile).to.have.property("full_name");
    expect(profile).to.have.property("username");
    expect(profile).to.have.property("email");
    expect(profile).to.have.property("route");
    expect(profile).to.not.have.property("password");
    expect(profile).to.not.have.property("_user_tags");
    expect(profile).to.not.have.property("_comments");
    expect(profile).to.not.have.property("_assign");
    expect(profile).to.not.have.property("_liked_by");
    expect(profile).to.not.have.property("docstatus");
    expect(profile).to.not.have.property("modified_by");
  });
}
