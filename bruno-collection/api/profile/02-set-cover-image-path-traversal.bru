docs {
  # set_cover_image path traversal prevention

  Same path traversal protection as `set_profile_image`, but for cover
  images. Uses `../../../etc/passwd` to test deeper traversal.

  **Endpoint**: `fossunited.api.profile.set_cover_image`
  **Auth**: `@frappe.whitelist()` (logged-in users)
  **Seed data**: none (uses crafted malicious path)
  **Source**: `fossunited/api/profile.py`
}

body:json {
  {
    "file_url": "../../../etc/passwd"
  }
}

tests {
  test("path traversal should be rejected", function() {
    const status = res.getStatus();
    expect(status).to.be.oneOf([403, 417, 500]);
  });
}
