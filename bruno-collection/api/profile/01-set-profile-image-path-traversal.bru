docs {
  # set_profile_image path traversal prevention

  Tests that `set_profile_image` rejects path traversal attempts.
  The payload `../../common_site_config.json` would escape the public
  directory and expose server configuration if not validated.

  Fix uses `os.path.realpath()` to resolve symlinks and `..` segments,
  then verifies the resolved path is under `{site}/public/`.

  **Endpoint**: `fossunited.api.profile.set_profile_image`
  **Auth**: `@frappe.whitelist()` (logged-in users)
  **Seed data**: none (uses crafted malicious path)
  **Source**: `fossunited/api/profile.py`
}

body:json {
  {
    "file_url": "../../common_site_config.json"
  }
}

tests {
  test("path traversal should be rejected", function() {
    const status = res.getStatus();
    expect(status).to.be.oneOf([403, 417, 500]);
  });
}
